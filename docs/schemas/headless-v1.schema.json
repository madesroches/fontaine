{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fontaine headless contract, version 1",
  "description": "Every object `fontaine -p` prints with --output-format json or stream-json, and every line it reads with --input-format stream-json. Additive fields keep schema_version 1; a rename or a removal bumps it. Consumers must ignore fields they do not know.",
  "oneOf": [
    { "$ref": "#/$defs/init" },
    { "$ref": "#/$defs/assistant" },
    { "$ref": "#/$defs/assistant_delta" },
    { "$ref": "#/$defs/tool_call" },
    { "$ref": "#/$defs/gate_decision" },
    { "$ref": "#/$defs/tool_result" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/user_input" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["type", "schema_version", "session_id"],
      "properties": {
        "schema_version": { "const": 1 },
        "session_id": { "type": "string", "minLength": 1 }
      }
    },
    "tier": {
      "enum": [
        "deny_rule",
        "ask_rule",
        "critical_path",
        "protected_path",
        "hook",
        "read_only_fast_path",
        "tier05",
        "allow_rule",
        "mode",
        "screen",
        "guardian",
        "dont_ask",
        "plan_block",
        "human"
      ]
    },
    "usage_bucket": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cost_usd"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "init": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "type",
            "model",
            "guardian_model",
            "guardian_profile",
            "permission_mode",
            "workspace_roots",
            "config_sources",
            "workspace_trust",
            "suspended_allow_rules"
          ],
          "properties": {
            "type": { "const": "init" },
            "model": { "type": "string", "pattern": "^[^/]+/.+$" },
            "guardian_model": { "type": ["string", "null"] },
            "guardian_available": { "type": ["boolean", "null"] },
            "guardian_profile": { "enum": ["full", "minimal"] },
            "permission_mode": {
              "enum": ["manual", "acceptEdits", "plan", "auto", "dontAsk"]
            },
            "workspace_roots": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "config_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["scope", "path", "loaded"],
                "properties": {
                  "scope": {
                    "enum": ["managed", "cli", "project-local", "project", "user"]
                  },
                  "path": { "type": ["string", "null"] },
                  "loaded": { "type": "boolean" }
                }
              }
            },
            "workspace_trust": { "enum": ["trusted", "untrusted"] },
            "suspended_allow_rules": {
              "type": "array",
              "items": { "type": "string" }
            },
            "tools": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "assistant": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "assistant" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "assistant_delta": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "assistant_delta" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "tool_call": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["type", "tool_use_id", "tool", "args"],
          "properties": {
            "type": { "const": "tool_call" },
            "tool_use_id": { "type": "string", "minLength": 1 },
            "tool": { "type": "string", "minLength": 1 },
            "args": { "type": "object" }
          }
        }
      ]
    },
    "gate_decision": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["type", "tool_use_id", "tier", "decision", "rule"],
          "properties": {
            "type": { "const": "gate_decision" },
            "tool_use_id": { "type": "string", "minLength": 1 },
            "agent_id": { "type": "string", "minLength": 1 },
            "tier": { "$ref": "#/$defs/tier" },
            "decision": { "enum": ["allow", "deny", "prompt"] },
            "rule": { "type": ["string", "null"] },
            "explanation": { "type": ["string", "null"] },
            "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "guardian_model": { "type": ["string", "null"] },
            "screen_risk": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "screen_outcome": { "enum": ["stop", "pass", "unavailable", null] },
            "fail_closed_reason": {
              "enum": ["error", "timeout", "unparseable", "low_confidence", "unavailable", null]
            }
          }
        }
      ]
    },
    "tool_result": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["type", "tool_use_id", "success", "text"],
          "properties": {
            "type": { "const": "tool_result" },
            "tool_use_id": { "type": "string", "minLength": 1 },
            "tool": { "type": "string" },
            "success": { "type": "boolean" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "result": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "type",
            "subtype",
            "is_error",
            "result",
            "num_turns",
            "duration_ms",
            "total_cost_usd",
            "usage",
            "denials"
          ],
          "properties": {
            "type": { "const": "result" },
            "subtype": {
              "enum": [
                "success",
                "error_max_turns",
                "error_max_budget_usd",
                "error_during_execution"
              ]
            },
            "is_error": { "type": "boolean" },
            "result": { "type": "string" },
            "error": { "type": ["string", "null"] },
            "structured_output": {},
            "num_turns": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 0 },
            "total_cost_usd": { "type": ["number", "null"], "minimum": 0 },
            "usage": {
              "type": "object",
              "required": ["main", "guardian", "subagents"],
              "properties": {
                "main": { "$ref": "#/$defs/usage_bucket" },
                "guardian": { "$ref": "#/$defs/usage_bucket" },
                "subagents": { "$ref": "#/$defs/usage_bucket" }
              }
            },
            "denials": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["tool", "tier", "rule", "explanation"],
                "properties": {
                  "tool": { "type": "string" },
                  "tier": { "$ref": "#/$defs/tier" },
                  "rule": { "type": ["string", "null"] },
                  "explanation": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      ]
    },
    "user_input": {
      "type": "object",
      "description": "One line of --input-format stream-json: Claude Code's user message shape. It carries no schema_version or session_id.",
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "user" },
        "message": {
          "type": "object",
          "required": ["role", "content"],
          "properties": {
            "role": { "const": "user" },
            "content": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "type": "string" },
                      "text": { "type": "string" }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
